# Email Configuration for Django's SMTP backend
# To use the backend email functionality, rename this file to ".env" and fill in the details.

# The email address that will SEND the notifications (e.g., your Gmail account)
SMTP_USER=your_email@gmail.com

# The app password for your email account. 
# For Gmail, you must enable 2-Step Verification and create an "App Password".
SMTP_PASS=your_app_password

# The email address that should RECEIVE the notifications (usually the doctor's email)
RECEIVER_EMAIL=doctor_email@example.com

# SMTP Server details (Defaults to Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# WhatsApp Business API Credentials
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
ADMIN_WHATSAPP_NUMBER=1234567890
